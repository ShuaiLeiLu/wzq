[Unit]
Description=Yijian online Gomoku
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/wzq/current/bin/wzq-server

[Service]
Type=simple
Environment=HOST=127.0.0.1 PORT=3041
ExecStart=/opt/wzq/current/bin/wzq-server
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
