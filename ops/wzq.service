[Unit]
Description=Yijian online Gomoku
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/wzq/current/server.js

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name wzq-node --network host --user 65532:65532 --cap-drop ALL --security-opt no-new-privileges --read-only --pids-limit 128 --memory 192m --env HOST=127.0.0.1 --env PORT=3041 --mount type=bind,src=/opt/wzq/current,dst=/app,readonly --workdir /app node@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530 node /app/server.js
ExecStop=-/usr/bin/docker stop --time 5 wzq-node
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
